{
  "name": "@grasdouble/lufa_design-system-cli",
  "version": "1.1.6",
  "private": false,
  "description": "Lufa Design System - CLI tools for theme validation",
  "repository": {
    "type": "git",
    "url": "https://github.com/grasdouble/lufa-design-system.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "lufa-ds-cli": "./bin/lufa-ds-cli"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "validate:a11y": "node dist/cli.js a11y",
    "validate:token-usage": "pnpm --filter @grasdouble/lufa_design-system-tokens run validate:token-usage -- --dir $PWD --ext .css,.ts",
    "validate:token-usage:unused": "pnpm --filter @grasdouble/lufa_design-system-tokens run validate:token-usage -- --dir $PWD --ext .css,.ts --unused",
    "validate:token-usage:verbose": "pnpm --filter @grasdouble/lufa_design-system-tokens run validate:token-usage -- --dir $PWD --ext .css,.ts --verbose"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bash -c 'pnpm typecheck'"
    ],
    "package.json": [
      "sort-package-json"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@grasdouble/lufa_design-system-tokens": "workspace:^",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@grasdouble/lufa_config_eslint": "^0.1.11",
    "@grasdouble/lufa_config_prettier": "^0.1.5",
    "@grasdouble/lufa_config_tsconfig": "^0.1.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "c8": "^11.0.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "sort-package-json": "^3.7.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
