{
  "name": "@grasdouble/lufa_design-system-tokens",
  "version": "1.2.7",
  "private": false,
  "description": "Lufa Design System - Semantic design tokens (colors, spacing, typography, etc.)",
  "repository": {
    "type": "git",
    "url": "https://github.com/grasdouble/lufa-design-system.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/tokens-values.json",
    "./tokens.css": "./dist/tokens.css",
    "./values": "./dist/tokens-values.json",
    "./metadata": "./dist/tokens-metadata.json",
    "./merged": "./dist/tokens-source-merged.json",
    "./map": "./dist/tokens.map.json",
    "./statistics": "./dist/token-statistics.json",
    "./themeable": "./dist/themeable-tokens.css",
    "./themeable-starter": "./dist/themeable-tokens-starter.css",
    "./themeable-extended": "./dist/themeable-tokens-extended.css",
    "./themeable-advanced": "./dist/themeable-tokens-advanced.css",
    "./tokens.map.json": "./dist/tokens.map.json"
  },
  "main": "./dist/tokens-values.json",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm validate:tokens",
    "build": "pnpm clean && style-dictionary build --config ./style-dictionary.config.js && pnpm merge:tokens && pnpm stats:generate && pnpm check:size",
    "check:size": "node scripts/check-package-size.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "merge:tokens": "node scripts/merge-tokens.mjs",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "stats:generate": "node scripts/generate-token-statistics.mjs",
    "stats:update": "node scripts/generate-token-statistics.mjs --write-readme",
    "test": "pnpm test:validator && pnpm test:wcag && pnpm test:shadow && pnpm test:container-aliases && pnpm test:size && pnpm test:statistics",
    "test:container-aliases": "node build/validators/container-aliases.test.js",
    "test:shadow": "node --test build/transforms/shadow-css-shorthand-custom.test.js",
    "test:size": "node --test scripts/check-package-size.test.mjs",
    "test:statistics": "node --test scripts/generate-token-statistics.test.mjs",
    "test:validator": "node build/validators/token-consistency.test.js",
    "test:wcag": "node build/utils/wcag-contrast.test.js",
    "typecheck": "pnpm lint",
    "validate:token-usage": "node scripts/validate-token-usage.js",
    "validate:tokens": "node build/validators/token-consistency.js"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@grasdouble/lufa_config_eslint": "^0.1.11",
    "@grasdouble/lufa_config_prettier": "^0.1.5",
    "@grasdouble/lufa_config_tsconfig": "^0.1.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^25.9.5",
    "eslint": "^10.8.0",
    "glob": "^13.0.6",
    "prettier": "^3.9.6",
    "sort-package-json": "^3.7.1",
    "style-dictionary": "^5.5.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
